<resources>
    <!-- Material 3 is the source of truth for colors, typography and component states. -->
    <style name="Theme.QMME" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
        <!--
          AppCompat TextAppearances inherit ?android:textColorPrimary. Platform /
          OEM overlays (and AppCompat's own #DE000000 high-emphasis token) can
          make that resolve to a washed 87%-black, which CollapsingToolbarLayout
          then paints as the expanded large title. Pin both primary/secondary
          text attrs to opaque M3 on-surface tokens so appearance-driven title
          colors stay fully contrasted.
        -->
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>

        <!--
          Keep the official M3 ListItemLayout grouping behavior, but square the
          *inner* corners. First/last retain their outer M3 large corners, so a
          segmented group reads as one card divided by MaterialDivider instead
          of several small rounded cards pressed together.
        -->
        <item name="listItemShapeAppearanceFirst">@style/ShapeAppearance.QMME.ListItem.First</item>
        <item name="listItemShapeAppearanceMiddle">@style/ShapeAppearance.QMME.ListItem.Middle</item>
        <item name="listItemShapeAppearanceLast">@style/ShapeAppearance.QMME.ListItem.Last</item>
    </style>

    <!--
      Emphasized large title used by the home flexible app bar. Bakes in
      colorOnSurface so setExpandedTitleTextAppearance() cannot reintroduce a
      washed textColorPrimary from the AppCompat parent chain.
    -->
    <style name="TextAppearance.QMME.CollapsingToolbar.ExpandedTitle"
        parent="TextAppearance.Material3.HeadlineMedium.Emphasized">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.QMME.CollapsingToolbar.CollapsedTitle"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.QMME.CollapsingToolbar.ExpandedSubtitle"
        parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.QMME.CollapsingToolbar.CollapsedSubtitle"
        parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="ShapeAppearance.QMME.ListItem.First" parent="">
        <item name="cornerFamily">?attr/shapeCornerFamily</item>
        <item name="cornerSizeTopLeft">?attr/shapeCornerSizeLarge</item>
        <item name="cornerSizeTopRight">?attr/shapeCornerSizeLarge</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.QMME.ListItem.Middle" parent="">
        <item name="cornerFamily">?attr/shapeCornerFamily</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="ShapeAppearance.QMME.ListItem.Last" parent="">
        <item name="cornerFamily">?attr/shapeCornerFamily</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">?attr/shapeCornerSizeLarge</item>
        <item name="cornerSizeBottomRight">?attr/shapeCornerSizeLarge</item>
    </style>
</resources>
